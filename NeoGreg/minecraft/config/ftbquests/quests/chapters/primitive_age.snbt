	quests: [
		{
			description: [
				"Welcome to NeoGreg! Have fun, and remember: It's about the journey, not the destination!"
				""
				"Oh, and no, you can't punch trees anymore. Follow the questbook if you want to live!"
			]
			icon: "kubejs:greg_icon"
			id: "442F94A7C8D135EF"
			shape: "gear"
			size: 1.5d
			subtitle: "And so, it begins!"
			title: "Hey! Hey! Listen! Hey! Listen! Listen! Hey!"
			x: 2.0d
			y: 0.0714285714285694d
		}
		{
			dependencies: ["442F94A7C8D135EF"]
			description: [
				"Before you go punching trees, you should probably punch some gravel."
				"You are looking for flint, it will be used for tools."
				""
				"Right click a piece of flint on exposed stone (cobblestone and surface rocks will do) to get a chance to recieve flint shards."
				""
				"Alternatively, you can sharpen the loose stones into useable shards too, but this might take you a bit longer than knapping flint."
			]
			id: "378855B5A042A7EB"
			subtitle: "Slightly more realistic earlygame"
			tasks: [
				{
					id: "0D438E198F033F13"
