	quests: [
		{
			dependencies: ["3C23D04261E94FC7"]
			description: [
				"Now that you've made it to some basic metal tools, you can start working on create contraptions! The first ingredient for all of those is andesite alloy, as it lets you make pretty much everything else."
				""
				"Right now the best you can do is the manual recipe with nuggets and andesite, but later on you'll get a more efficient recipe in a mechanical mixer."
			]
			id: "1B09ABB4A5E9F305"
			shape: "gear"
			size: 1.5d
			subtitle: "Just in case you thought the steam age was primitive"
			tasks: [{
