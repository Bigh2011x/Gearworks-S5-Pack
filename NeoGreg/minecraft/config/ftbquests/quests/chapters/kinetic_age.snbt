			}]
			x: -3.5d
			y: -1.5d
		}
		{
			dependencies: ["6C3F49E77B478E3A"]
			description: [
				"These are required for progression, but you should definitely use them for ore processing."
				""
				"Already, these can significantly increase your ore yield, though this effect is much less potent than that of a gregtech machine (the first crushing step gives you a 20% chance at an extra ore, while a macerator is guaranteed to give you double output)."
				""
				"Also, you'll get free experience for using these! What a deal!"
			]
			id: "4F70C55B3B3D4AA1"
			subtitle: "The better millstone!"
			tasks: [{
				count: 2L
