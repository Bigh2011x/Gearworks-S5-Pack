		{
			dependencies: ["1B09ABB4A5E9F305"]
			description: [
				"In this pack, you can make brass right away! Use a mortar (or something else) to grind down some copper and zinc, then mix them in a crafting table and smelt the brass dust."
				""
				"You'll need a little bit of this for progression and create machines."
			]
			id: "4F59824E605DCC8C"
			shape: "gear"
			subtitle: "The secret second starting point"
