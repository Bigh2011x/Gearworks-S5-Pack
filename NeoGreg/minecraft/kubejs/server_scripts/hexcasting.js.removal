//priority: 10
//requires: gtceu
//requires: minecraft
//requires: hexcasting
//requires: waystones

ServerEvents.recipes(event => {
    
    event.remove({output:"#hexcasting:staves"});
    function staff(mat){ //staves
        event.shaped(
        Item.of('hexcasting:staff/'+mat, 1),
  	[
  	  ' cA',
  	  ' mc',
  	  'r  '
  	],
  	  {
  	    r:"gtceu:long_aluminium_rod",
  	    c:"#gtceu:circuits/mv",
  	    m:"minecraft:"+mat+"_planks",
  	    A:"hexcasting:charged_amethyst"
  	  }
  	)
    }
    
    ["oak","spruce","birch","jungle","acacia","dark_oak","crimson","warped","mangrove","cherry","bamboo"].forEach(element => {
        staff(element);
    });
    
    //some odd ones out
    event.shaped(
        Item.of('hexcasting:staff/edified', 1),
  	[
  	  ' cA',
  	  ' mc',
  	  'r  '
  	],
  	  {
  	    r:"gtceu:long_aluminium_rod",
  	    c:"#gtceu:circuits/mv",
  	    m:"hexcasting:edified_planks",
  	    A:"hexcasting:charged_amethyst"
  	  }
  	)
    event.shaped(
        Item.of('hexcasting:staff/quenched', 1),
  	[
  	  ' cA',
  	  ' mc',
  	  'r  '
  	],
  	  {
  	    r:"gtceu:long_aluminium_rod",
  	    c:"#gtceu:circuits/mv",
  	    m:"hexcasting:quenched_allay_shard",
  	    A:"hexcasting:charged_amethyst"
  	  }
  	)
    event.shaped(
        Item.of('hexcasting:staff/mindsplice', 1),
  	[
  	  ' cA',
  	  ' mc',
  	  'r  '
  	],
  	  {
  	    r:"gtceu:long_aluminium_rod",
  	    c:"#gtceu:circuits/mv",
  	    m:"#hexcasting:brainswept_circle_components",
  	    A:"hexcasting:charged_amethyst"
  	  }
  	)

    //event.replaceInput({output:"#hexcasting:staves"},"minecraft:stick","gtceu:aluminium_rod"); //make rods gated at aluminium
    event.remove({id: "hexcasting:compat/create/crushing/amethyst_shard"}) //remove the 1 shard -> 5 dust crushing recipe
  event.recipes.gtceu.polarizer('charge_amethyst')
    .itemInputs(
  	  '1x minecraft:amethyst_shard'
  	)
  	.itemOutputs(
  	  Item.of('hexcasting:charged_amethyst')
  	)
  	.duration(360)
    .EUt(510)
  event.remove({id:"waystones:warp_stone"})
  event.shaped( //warp stone recipe change
    Item.of('waystones:warp_stone', 1), // arg 1: output
  	[
  	  'AEA',
  	  'ESE', // arg 2: the shape (array of strings)
  	  'AEA'
  	],
  	  {
  	    A:'hexcasting:quenched_allay_shard',
  	    E:'minecraft:ender_pearl',
  	    S:["#gtceu:circuits/ev","hexcasting:artifact"]
  	  }
  	)
  event.recipes.gtceu.electrolyzer('quenched_allay_replication') //replicate quenched allay with non-magical means
	.notConsumable('hexcasting:quenched_allay_shard')
    .itemInputs(
      '4x hexcasting:charged_amethyst'
    )
    .itemOutputs(
      Item.of('hexcasting:quenched_allay_shard')
    )
    .duration(360)
    .EUt(510)
  event.remove({id:"create_enchantment_industry:crafting/enchanting_guide"})
  event.shapeless( //enchanting guide
    Item.of('create_enchantment_industry:enchanting_guide'), // arg 1: output
    [
      'minecraft:book','hexcasting:edified_planks'
    ])
})
